#!/bin/sh
# Bumps the build number, regenerates freezed/json_serializable code and runs
# `flutter analyze` before every push. CI no longer runs analyze — this is the
# single gate for it, to keep GitHub Actions time down.
#
# HOW THE BUMP RIDES ALONG WITH THE PUSH
#
# A pre-push hook runs after git has already resolved which commits to send, so
# a commit created here would be left behind — the push would carry the old SHA
# and the branch would end up silently one commit ahead of the remote.
#
# So the hook does the push itself: it bumps, commits, and pushes both commits
# with --no-verify (which is what keeps it from re-entering this hook). The
# outer push is then aborted with exit 1, because there is nothing left for it
# to do. Git prints its usual "failed to push" line; the message below says
# plainly that the push already happened.
#
# The result is what a single `git push` should do: the bump travels with the
# work, in its own commit.
set -e

REMOTE_NAME=${1:-origin}
BRANCH=$(git rev-parse --abbrev-ref HEAD)
REMOTE_REF="$REMOTE_NAME/$BRANCH"

read_build() {
  # `version: 1.0.0+7` -> `7`
  printf '%s' "$1" | grep '^version:' | cut -d: -f2 | tr -d ' ' | sed 's/.*+//'
}

LOCAL_BUILD=$(read_build "$(cat pubspec.yaml)")

# A branch that never reached the remote has nothing to compare against; treat
# the remote build as 0 so the first push still bumps.
if git rev-parse --verify --quiet "$REMOTE_REF" >/dev/null; then
  REMOTE_BUILD=$(read_build "$(git show "$REMOTE_REF:pubspec.yaml")")
else
  REMOTE_BUILD=0
fi

# Checks that would otherwise run after the push has already left. Doing them
# first means a failing analyze stops everything, bump included.
dart run build_runner build --delete-conflicting-outputs
flutter analyze

if [ "$LOCAL_BUILD" -le "$REMOTE_BUILD" ]; then
  NEXT=$((REMOTE_BUILD + 1))
  CURRENT_VERSION=$(grep '^version:' pubspec.yaml | cut -d: -f2 | tr -d ' ')
  APP_VERSION=${CURRENT_VERSION%%+*}

  # A temp file plus mv, because `sed -i` differs between BSD and GNU and this
  # repo is developed on macOS but built on ubuntu-latest.
  sed "s/^version:.*/version: $APP_VERSION+$NEXT/" pubspec.yaml > pubspec.yaml.tmp
  mv pubspec.yaml.tmp pubspec.yaml

  git add pubspec.yaml
  git commit -m "chore: bump build number to $NEXT"

  echo ""
  echo "Bumped to $APP_VERSION+$NEXT and pushing it with your commits..."
  git push --no-verify "$REMOTE_NAME" "$BRANCH"

  echo ""
  echo "Pushed. The 'failed to push' line below is expected: this hook already"
  echo "sent everything, including the bump commit. Nothing left to do."
  exit 1
fi
