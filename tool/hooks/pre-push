#!/bin/sh
# Bumps the build number, regenerates freezed/json_serializable code and runs
# `flutter analyze` plus the VM test suite before every push. CI no longer runs
# analyze — this is the single gate for it, to keep GitHub Actions time down.
#
# The bump touches two files, not one: `version:` in pubspec.yaml and the
# BUILD_NUMBER fallback in lib/core/app_version.dart. They are asserted equal by
# `app_version_test.dart`, so bumping only the first turns CI red on every push
# — which is exactly what happened on build 2.
#
# HOW THE BUMP RIDES ALONG WITH THE PUSH
#
# A pre-push hook runs after git has already resolved which commits to send, so
# a commit created here would be left behind — the push would carry the old SHA
# and the branch would end up silently one commit ahead of the remote.
#
# So the hook does the push itself: it bumps, commits, and pushes both commits
# with --no-verify (which is what keeps it from re-entering this hook). The
# outer push is then aborted with exit 1, because there is nothing left for it
# to do. Git prints its usual "failed to push" line; the message below says
# plainly that the push already happened.
#
# The result is what a single `git push` should do: the bump travels with the
# work, in its own commit.
set -e

REMOTE_NAME=${1:-origin}
BRANCH=$(git rev-parse --abbrev-ref HEAD)
REMOTE_REF="$REMOTE_NAME/$BRANCH"

read_build() {
  # `version: 1.0.0+7` -> `7`
  printf '%s' "$1" | grep '^version:' | cut -d: -f2 | tr -d ' ' | sed 's/.*+//'
}

LOCAL_BUILD=$(read_build "$(cat pubspec.yaml)")

# A branch that never reached the remote has nothing to compare against; treat
# the remote build as 0 so the first push still bumps.
if git rev-parse --verify --quiet "$REMOTE_REF" >/dev/null; then
  REMOTE_BUILD=$(read_build "$(git show "$REMOTE_REF:pubspec.yaml")")
else
  REMOTE_BUILD=0
fi

# Checks that would otherwise run after the push has already left. Doing them
# first means a failing analyze stops everything, bump included.
dart run build_runner build --delete-conflicting-outputs
flutter analyze

if [ "$LOCAL_BUILD" -le "$REMOTE_BUILD" ]; then
  NEXT=$((REMOTE_BUILD + 1))
  CURRENT_VERSION=$(grep '^version:' pubspec.yaml | cut -d: -f2 | tr -d ' ')
  APP_VERSION=${CURRENT_VERSION%%+*}

  # A temp file plus mv, because `sed -i` differs between BSD and GNU and this
  # repo is developed on macOS but built on ubuntu-latest.
  sed "s/^version:.*/version: $APP_VERSION+$NEXT/" pubspec.yaml > pubspec.yaml.tmp
  mv pubspec.yaml.tmp pubspec.yaml

  # The fallback in app_version.dart has to follow, or every push turns CI red:
  # `app_version_test.dart` asserts the two agree, and it is right to — the
  # About screen names the running bundle even under `flutter run`, where no
  # --dart-define is passed and only this default answers.
  # awk, not sed: the replacement has to be the `defaultValue` that belongs to
  # BUILD_NUMBER, not the one under APP_VERSION a few lines above. Anchoring on
  # the environment key makes that explicit instead of relying on '1.0.0' not
  # happening to match a digits-only pattern.
  awk -v next_build="$NEXT" '
    /BUILD_NUMBER/ { seen = 1 }
    seen && /defaultValue:/ {
      sub(/defaultValue: .*/, "defaultValue: \x27" next_build "\x27,")
      seen = 0
    }
    { print }
  ' lib/core/app_version.dart > app_version.dart.tmp
  mv app_version.dart.tmp lib/core/app_version.dart

  if ! grep -q "defaultValue: '$NEXT'," lib/core/app_version.dart; then
    echo "pre-push: could not bump the fallback in lib/core/app_version.dart." >&2
    echo "Its shape changed; fix the sed above before pushing." >&2
    exit 1
  fi

  # Only now, with the bump written, do the tests mean anything: running them
  # before it would pass on a version pair the push is about to break — exactly
  # the failure that shipped in build 2. The commit comes after, so a red suite
  # leaves no orphan bump commit behind, only the two edited files, which the
  # message below tells you how to drop.
  if ! flutter test --exclude-tags=chrome-only; then
    echo "" >&2
    echo "pre-push: tests failed, nothing was committed or pushed." >&2
    echo "The build bump is still in your working tree; to drop it:" >&2
    echo "  git checkout pubspec.yaml lib/core/app_version.dart" >&2
    exit 1
  fi

  git add pubspec.yaml lib/core/app_version.dart
  git commit -m "chore: bump build number to $NEXT"

  echo ""
  echo "Bumped to $APP_VERSION+$NEXT and pushing it with your commits..."
  git push --no-verify "$REMOTE_NAME" "$BRANCH"

  echo ""
  echo "Pushed. The 'failed to push' line below is expected: this hook already"
  echo "sent everything, including the bump commit. Nothing left to do."
  exit 1
fi
